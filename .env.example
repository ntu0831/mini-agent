# ============================================================================
# MiniAgent configuration
# Copy this file to .env and fill in the values you need.
# ============================================================================

# ---------------------------------------------------------------------------
# Model (any OpenAI-compatible /chat/completions endpoint)
# ---------------------------------------------------------------------------
MINI_AGENT_MODEL=your-model-name
MINI_AGENT_API_KEY=your-api-key
MINI_AGENT_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds and sampling temperature (0 is the most stable).
MINI_AGENT_TIMEOUT=60
MINI_AGENT_TEMPERATURE=0

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# ReAct step budget.
MINI_AGENT_MAX_STEPS=5

# Retries for transient LLM failures (429, 5xx, timeouts).
MINI_AGENT_MAX_RETRIES=3

# Maximum characters kept from a single tool observation.
MINI_AGENT_MAX_OBSERVATION_CHARS=4000

# Deterministic offline model. Useful without an API key.
# MINI_AGENT_MOCK=1

# Optional JSONL trace output (one file, append mode).
# MINI_AGENT_TRACE=traces/run.jsonl

# ---------------------------------------------------------------------------
# Local model examples
# ---------------------------------------------------------------------------
# Ollama (no API key needed):
# MINI_AGENT_BASE_URL=http://localhost:11434/v1
# MINI_AGENT_MODEL=qwen2.5:7b
#
# vLLM:
# MINI_AGENT_BASE_URL=http://localhost:8000/v1
# MINI_AGENT_MODEL=your-served-model

# ---------------------------------------------------------------------------
# Search tool (optional, pick one)
# ---------------------------------------------------------------------------
# Tavily: https://tavily.com/  (pip install tavily-python)
# TAVILY_API_KEY=tvly-your-key
#
# SerpApi: https://serpapi.com/  (pip install google-search-results)
# SERPAPI_API_KEY=your-key
#
# Free option: pip install ddgs

# ---------------------------------------------------------------------------
# Compatibility aliases
# ---------------------------------------------------------------------------
# If MINI_AGENT_* is not set, the loader also accepts:
#   LLM_MODEL_ID, LLM_API_KEY, LLM_BASE_URL, LLM_TIMEOUT,
#   OPENAI_API_KEY, OPENAI_MODEL, MODELSCOPE_API_KEY
